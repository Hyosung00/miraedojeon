{
  "name": "miraedojeon",
  "version": "1.0.0",
  "description": "Web GUI Integration - Frontend and Backend",
  "private": true,
  "scripts": {
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd front && npm start",
    "install:all": "concurrently \"npm run install:backend\" \"npm run install:frontend\"",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd front && npm install",
    "dev": "npm start",
    "build": "cd front && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
